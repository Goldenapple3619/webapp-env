WEBSERVER_PORT=80
SYSTEM_DIR=./system

POSTGRES_DB=gzdb
POSTGRES_USER=gzdb
POSTGRES_PASSWORD=change-me

SALT=change-me
JWT_SECRET=
ACCESS_TOKEN_TTL=900
SESSION_TTL_DAYS=30
SESSION_MAX_DAYS=90
ALLOW_REGISTRATION=true
COOKIE_SECURE=auto
COOKIE_SAMESITE=auto

MAX_UPLOAD_MB=2048

PUBLIC_URL=
CORS_ORIGINS=
WS_ALLOWED_ORIGINS=

CSP_REMOTE_SRC=
CSP_CONNECT_SRC=

TRUST_PROXY=1
LOG_LEVEL=info
RATE_LIMITS=on
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_GLOBAL_PER_MINUTE=1200
MAX_CONCURRENT_ZIPS=2
DNS_RESOLVER=127.0.0.11
